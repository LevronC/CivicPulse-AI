# Copy to apps/web/.env.local for local dev

# Optional: call backend directly (requires CORS on API)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only: backend target for /api/* proxy (recommended on Vercel)
API_URL=http://localhost:8000

# Server-only: forwarded on mutating proxy requests when client omits the header
API_KEY=dev-api-key
