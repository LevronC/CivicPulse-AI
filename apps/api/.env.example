# Vercel serverless API — copy to apps/api/.env for local vercel dev

ENVIRONMENT=production
LOG_LEVEL=INFO
EMBEDDING_MODEL=heuristic
EMBEDDING_DIMS=384
GRAPH_MODE=true
SOURCE_PROVIDERS=["rss"]
RSS_FEEDS=["https://rss.nytimes.com/services/xml/rss/nyt/World.xml"]
API_KEY=dev-api-key
RATE_LIMIT_PER_MIN=60
DB_POOL_SIZE=1
DB_POOL_OVERFLOW=0

# Required — use Neon Postgres from Vercel Marketplace
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/DB?sslmode=require
