ENVIRONMENT=development
LOG_LEVEL=INFO
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=civicpulse
DATABASE_URL=postgresql+psycopg://civicpulse:civicpulse@localhost:5432/civicpulse
DB_POOL_SIZE=5
DB_POOL_OVERFLOW=10
REDIS_URL=redis://localhost:6379/0
API_KEY=dev-api-key
RATE_LIMIT_PER_MIN=60
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=
API_URL=http://localhost:8000
HF_MODEL_SUMMARY=heuristic
HF_MODEL_CLASSIFIER=heuristic
HF_MODEL_SENTIMENT=heuristic
HF_MODEL_NER=heuristic
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMS=384
# Switch to RSS for live ingestion: SOURCE_PROVIDERS=["rss"]
SOURCE_PROVIDERS=["rss"]
RSS_FEEDS=["https://rss.nytimes.com/services/xml/rss/nyt/World.xml"]

NEWSAPI_API_KEY=
NEWSAPI_QUERY=politics OR conflict OR protest OR election
NEWSAPI_LANGUAGE=en
GDELT_QUERY=protest OR election OR conflict OR disaster
SOURCE_PROVIDER_PAGE_SIZE=50
SOURCE_TIMEOUT_SECONDS=10
SOURCE_RETRY_ATTEMPTS=3
GRAPH_MODE=true
GRAPH_ATTACH_THRESHOLD=0.40
GRAPH_MERGE_THRESHOLD=0.72
GRAPH_STALE_HOURS=72
