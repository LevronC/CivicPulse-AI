#!/bin/sh
# Reject commit messages that credit AI agents as co-authors.

MSG_FILE=$1

if grep -Eiq '^Co-[Aa]uthored-by:.*(cursor|copilot|openai|composer|devin|sweep|codegen|dependabot|github-actions|\[bot\]|agent@|ai@|bot@)' "$MSG_FILE"; then
  printf 'ERROR: Co-authored-by lines from AI/agents are not allowed.\n' >&2
  exit 1
fi

if grep -Eiq '^Co-[Aa]uthored-by:.*(Cursor Agent|Composer|Devin|Copilot|ChatGPT|Claude Bot)' "$MSG_FILE"; then
  printf 'ERROR: Co-authored-by lines from AI/agents are not allowed.\n' >&2
  exit 1
fi
