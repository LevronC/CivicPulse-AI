{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CivicPulseEvent",
  "type": "object",
  "required": ["id", "title", "topic", "sentiment", "impact_score", "latitude", "longitude"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "topic": { "type": "string" },
    "sentiment": { "type": "string" },
    "impact_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "article_ids": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
